{
  "name": "@deckjsx/node",
  "version": "0.1.1",
  "description": "Node.js runtime helpers for deckjsx render artifacts.",
  "license": "MIT",
  "bin": {
    "deckjsx": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./dev": {
      "types": "./dist/dev.d.mts",
      "import": "./dist/dev.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "rolldown": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "vite-plus": "^0.1.24"
  },
  "peerDependencies": {
    "deckjsx": "^0.9.1"
  },
  "packageManager": "bun@1.3.14"
}
