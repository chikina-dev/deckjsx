{
  "name": "@deckjsx/node",
  "version": "0.1.7",
  "description": "Node.js runtime helpers for deckjsx render artifacts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chikina-dev/deckjsx.git"
  },
  "bin": {
    "deckjsx": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./dev": {
      "types": "./dist/dev.d.mts",
      "import": "./dist/dev.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "rolldown": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260616.1",
    "typescript": "^7.0.2",
    "vite-plus": "0.2.4"
  },
  "peerDependencies": {
    "deckjsx": "^0.9.5"
  },
  "packageManager": "bun@1.3.14"
}
