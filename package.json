{
  "name": "deckjsx",
  "version": "0.2.0",
  "description": "Generate PowerPoint presentations from TSX/JSX through a compiler pipeline.",
  "license": "MIT",
  "author": "deckjsx contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/chikina-dev/deckjsx"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./jsx-dev-runtime": "./dist/jsx-dev-runtime.mjs",
    "./jsx-runtime": "./dist/jsx-runtime.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "verify:render": "bun run scripts/verify-render.ts",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.13",
  "inlinedDependencies": {
    "core-util-is": "1.0.3",
    "image-size": "1.2.1",
    "immediate": "3.0.6",
    "inherits": "2.0.4",
    "isarray": "1.0.0",
    "jszip": "3.10.1",
    "lie": "3.3.0",
    "pako": "1.0.11",
    "process-nextick-args": "2.0.1",
    "queue": "6.0.2",
    "readable-stream": "2.3.8",
    "safe-buffer": "5.1.2",
    "setimmediate": "1.0.5",
    "string_decoder": "1.1.1",
    "util-deprecate": "1.0.2"
  }
}
