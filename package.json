{
  "name": "deckjsx",
  "version": "0.9.0",
  "description": "Generate PowerPoint presentations from TSX/JSX through a compiler pipeline.",
  "license": "MIT",
  "author": "deckjsx contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chikina-dev/deckjsx.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.mts",
      "import": "./dist/adapter.mjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.mts",
      "import": "./dist/inspect.mjs"
    },
    "./integration": {
      "types": "./dist/integration.d.mts",
      "import": "./dist/integration.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "import": "./dist/jsx-dev-runtime.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "benchmark:pptx": "bun run scripts/benchmark-pptx-writer.tsx",
    "verify:render": "bun run .github/render/verify-render.tsx",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "fflate": "^0.8.3",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.13"
}
