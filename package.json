{
  "name": "deckjsx",
  "version": "0.9.5",
  "description": "Generate PowerPoint presentations from TSX/JSX through a compiler pipeline.",
  "license": "MIT",
  "author": "deckjsx contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chikina-dev/deckjsx.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.mts",
      "import": "./dist/adapter/index.mjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.mts",
      "import": "./dist/inspect.mjs"
    },
    "./integration": {
      "types": "./dist/integration.d.mts",
      "import": "./dist/integration.mjs"
    },
    "./style": {
      "types": "./dist/style/public.d.mts",
      "import": "./dist/style/public.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "import": "./dist/jsx-dev-runtime.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "benchmark:interactive": "node scripts/benchmark-interactive-dev.mjs",
    "benchmark:node": "node --preserve-symlinks --preserve-symlinks-main scripts/benchmark-node-runtime.mjs",
    "benchmark:pptx": "bun run scripts/benchmark-pptx-writer.tsx",
    "perf:calc": "bun run scripts/performance-calculator.tsx",
    "perf:types": "node scripts/type-performance.mjs",
    "smoke:tarball": "node scripts/tarball-smoke.mjs",
    "verify:render": "bun run .github/render/verify-render.tsx",
    "verify:render-confidence": "bun run .github/render/verify-render.tsx",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "bidi-js": "^1.0.3",
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260616.1",
    "@vitest/coverage-v8": "4.1.10",
    "bumpp": "^11.1.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite-plus": "0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
