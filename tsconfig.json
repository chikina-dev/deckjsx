{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "jsx": "react-jsx",
    "jsxImportSource": "deckjsx",
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "deckjsx": ["./src/index.ts"],
      "deckjsx/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "deckjsx/jsx-runtime": ["./src/jsx-runtime.ts"]
    }
  },
  "exclude": ["dist", "sample"]
}
