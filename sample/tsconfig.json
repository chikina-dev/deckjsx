{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "deckjsx",
    "types": ["node"],
    "paths": {
      "deckjsx": ["../src/index.ts"],
      "deckjsx/jsx-runtime": ["../src/jsx-runtime.ts"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
